rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsClip(clipId) {
      return request.auth != null
        && get(/databases/$(database)/documents/clips/$(clipId)).data.authorId == request.auth.uid;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Clips compartidos: lectura publica, escritura solo del autor.
    match /clips/{clipId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.clip.authorId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.clipId == clipId
          && request.resource.data.username is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 160
          && request.resource.data.keys().hasOnly([
            "authorId", "clipId", "username", "text", "createdAt"
          ]);
        allow update: if false;
        allow delete: if request.auth != null
          && (resource.data.authorId == request.auth.uid || ownsClip(clipId));
      }

      match /votes/{userId} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(["adLike", "used", "updatedAt"])
          && (!request.resource.data.keys().hasAny(["adLike"])
            || request.resource.data.adLike in ["yes", "no"])
          && (!request.resource.data.keys().hasAny(["used"])
            || request.resource.data.used in ["yes", "no"]);
        allow delete: if request.auth != null
          && (request.auth.uid == userId || ownsClip(clipId));
      }
    }
  }
}
